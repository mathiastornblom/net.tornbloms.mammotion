{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "net.tornbloms.mammotion",
  "version": "1.0.1",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Mammotion"
  },
  "description": {
    "en": "Adds support for Mammotion devices"
  },
  "category": [
    "appliances"
  ],
  "brandColor": "#2DAB68",
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Mathias Törnblom",
    "email": "mathias@tornbloms.net"
  },
  "flow": {
    "triggers": [
      {
        "id": "mower_started_mowing",
        "title": {
          "en": "Mower started mowing"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=luba"
          }
        ]
      },
      {
        "id": "mower_docked",
        "title": {
          "en": "Mower docked"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=luba"
          }
        ]
      },
      {
        "id": "mower_error",
        "title": {
          "en": "Mower reported an error"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=luba"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "is_mowing",
        "title": {
          "en": "Mower !{{is|isn't}} mowing"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=luba"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "start_mowing",
        "title": {
          "en": "Start mowing"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=luba"
          }
        ]
      },
      {
        "id": "send_to_dock",
        "title": {
          "en": "Send to dock"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=luba"
          }
        ]
      },
      {
        "id": "pause_mowing",
        "title": {
          "en": "Pause mowing"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=luba"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Mammotion Robot Mower"
      },
      "class": "other",
      "capabilities": [
        "onoff",
        "measure_battery",
        "alarm_generic",
        "mower_status",
        "measure_mow_progress",
        "measure_mow_area",
        "mow_blade_height"
      ],
      "energy": {
        "batteries": [
          "INTERNAL"
        ]
      },
      "capabilitiesOptions": {
        "onoff": {
          "title": {
            "en": "Mowing"
          }
        },
        "alarm_generic": {
          "title": {
            "en": "Error"
          }
        }
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials"
        },
        {
          "id": "list_devices",
          "template": "list_devices"
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "images": {
        "small": "/drivers/luba/assets/images/small.png",
        "large": "/drivers/luba/assets/images/large.png",
        "xlarge": "/drivers/luba/assets/images/xlarge.png"
      },
      "id": "luba"
    }
  ],
  "capabilities": {
    "measure_mow_area": {
      "type": "number",
      "title": {
        "en": "Mowed Area"
      },
      "units": {
        "en": "m²"
      },
      "min": 0,
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "measure_mow_progress": {
      "type": "number",
      "title": {
        "en": "Mow Progress"
      },
      "units": {
        "en": "%"
      },
      "min": 0,
      "max": 100,
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "mow_blade_height": {
      "type": "number",
      "title": {
        "en": "Blade Height"
      },
      "units": {
        "en": "mm"
      },
      "min": 15,
      "max": 100,
      "step": 5,
      "decimals": 0,
      "getable": true,
      "setable": true,
      "uiComponent": "slider",
      "icon": "/assets/icon.svg"
    },
    "mower_status": {
      "type": "enum",
      "values": [
        {
          "id": "idle",
          "title": {
            "en": "Idle"
          }
        },
        {
          "id": "mowing",
          "title": {
            "en": "Mowing"
          }
        },
        {
          "id": "returning",
          "title": {
            "en": "Returning"
          }
        },
        {
          "id": "charging",
          "title": {
            "en": "Charging"
          }
        },
        {
          "id": "paused",
          "title": {
            "en": "Paused"
          }
        },
        {
          "id": "error",
          "title": {
            "en": "Error"
          }
        }
      ],
      "title": {
        "en": "Mower Status"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor"
    }
  }
}