{
  "name": "net.tornbloms.mammotion",
  "version": "2.3.5",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint --ext .js,.ts --ignore-path .gitignore .",
    "compose": "homey app compose",
    "proto:gen": "node scripts/gen-proto.mjs",
    "test:proto": "tsc && node --test scripts/proto-roundtrip.test.mjs",
    "test:ble": "tsc && node --test scripts/blufi-codec.test.mjs",
    "test:schedule": "tsc && node --test scripts/schedule-roundtrip.test.mjs",
    "test:routing": "tsc && node --test scripts/device-routing.test.mjs",
    "test": "npm run test:proto && npm run test:ble && npm run test:schedule && npm run test:routing && npm run test:crash && npm run test:aliyun-signing",
    "test:crash": "tsc && node --test scripts/crash-reporter.test.mjs",
    "test:aliyun-signing": "tsc && node --test scripts/aliyun-signing.test.mjs"
  },
  "dependencies": {
    "mqtt": "^5.10.1",
    "protobufjs": "^7.6.4"
  },
  "devDependencies": {
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.12",
    "@types/node": "^26.0.1",
    "eslint": "^7.32.0",
    "eslint-config-athom": "^3.1.5",
    "typescript": "^6.0.3"
  }
}
