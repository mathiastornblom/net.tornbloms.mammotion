{
  "name": "net.tornbloms.mammotion",
  "version": "2.5.35",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint --ext .js,.ts --ignore-path .gitignore .",
    "compose": "homey app compose",
    "proto:gen": "node scripts/gen-proto.mjs",
    "test:proto": "tsc && node --test scripts/proto-roundtrip.test.mjs",
    "test:ble": "tsc && node --test scripts/blufi-codec.test.mjs",
    "test:schedule": "tsc && node --test scripts/schedule-roundtrip.test.mjs",
    "test:routing": "tsc && node --test scripts/device-routing.test.mjs",
    "test:device-type": "tsc && node --test scripts/device-type.test.mjs",
    "test": "npm run test:proto && npm run test:ble && npm run test:schedule && npm run test:routing && npm run test:device-type && npm run test:crash && npm run test:aliyun-signing && npm run test:aliyun-mqtt-credentials && npm run test:aliyun-commands && npm run test:mqtt-invoke-response && npm run test:aliyun-credentials-manager && npm run test:work-mode-status && npm run test:error-code && npm run test:sensor-status && npm run test:ble-backoff",
    "test:crash": "tsc && node --test scripts/crash-reporter.test.mjs",
    "test:aliyun-signing": "tsc && node --test scripts/aliyun-signing.test.mjs",
    "test:aliyun-mqtt-credentials": "tsc && node --test scripts/aliyun-mqtt-credentials.test.mjs",
    "test:aliyun-commands": "tsc && node --test scripts/aliyun-commands.test.mjs",
    "test:mqtt-invoke-response": "tsc && node --test scripts/mqtt-invoke-response.test.mjs",
    "test:aliyun-credentials-manager": "tsc && node --test scripts/aliyun-credentials-manager.test.mjs",
    "test:work-mode-status": "tsc && node --test scripts/work-mode-status.test.mjs",
    "test:error-code": "tsc && node --test scripts/error-code-roundtrip.test.mjs",
    "test:sensor-status": "tsc && node --test scripts/sensor-status-decode.test.mjs",
    "test:ble-backoff": "tsc && node --test scripts/ble-backoff.test.mjs"
  },
  "dependencies": {
    "mqtt": "^5.10.1",
    "protobufjs": "^7.6.4"
  },
  "devDependencies": {
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.12",
    "@types/node": "^26.0.1",
    "eslint": "^7.32.0",
    "eslint-config-athom": "^3.1.5",
    "typescript": "^6.0.3"
  }
}
